{
  "今天": [
    {
      "op": "widgets",
      "description": "调整首页小组件：enabled为要显示的完整名称数组，order按希望顺序列出组件，未列出的按原顺序保留；noticeScope=ALL显示全部通知/FOLLOWED只显示关注来源；各项可单独修改，可用名称见widgetOrder",
      "fields": [
        "enabled",
        "order",
        "noticeScope"
      ],
      "writes": true
    }
  ],
  "日历": [
    {
      "op": "view",
      "description": "周历查看：date=YYYY-MM-DD，list=DDL/TDL/空；overlap=并排/叠放/智能折叠",
      "fields": [
        "date",
        "list",
        "overlap"
      ],
      "writes": false
    }
  ],
  "账单": [
    {
      "op": "month",
      "description": "切换账单月份 month=YYYY-MM",
      "fields": [
        "month"
      ],
      "writes": false
    }
  ],
  "信息查询": [
    {
      "op": "view",
      "description": "切换资料分组与搜索，section=个人信息/老师信息/校园服务，query可空",
      "fields": [
        "section",
        "query"
      ],
      "writes": false
    }
  ],
  "晨签": [
    {
      "op": "month",
      "description": "切换晨签月历 month=YYYY-MM",
      "fields": [
        "month"
      ],
      "writes": false
    }
  ],
  "天气": [
    {
      "op": "refresh",
      "description": "刷新真实天气数据",
      "fields": [],
      "writes": false
    },
    {
      "op": "notification",
      "description": "天气通知 period=晨间/晚间（默认晨间），enabled布尔,time=HH:mm；晨间预报今天，晚间预报明天",
      "fields": [
        "period",
        "enabled",
        "time"
      ],
      "writes": true
    }
  ],
  "手持弹幕": [
    {
      "op": "configure",
      "description": "弹幕 text,size(32-240),speed(20-300),foreground/background(#RRGGBB),landscape,moving,blink,bold,shake(0-12)",
      "fields": [
        "text",
        "size",
        "speed",
        "foreground",
        "background",
        "landscape",
        "moving",
        "blink",
        "bold",
        "shake"
      ],
      "writes": true
    },
    {
      "op": "show",
      "description": "全屏显示当前弹幕",
      "fields": [],
      "writes": false
    }
  ],
  "工具": [
    {
      "op": "search",
      "description": "筛选工具名称",
      "fields": [
        "query"
      ],
      "writes": false
    }
  ],
  "专注": [
    {
      "op": "configure",
      "description": "设置时长 minutes=1..480，可选notifications/calls布尔",
      "fields": [
        "minutes",
        "notifications",
        "calls"
      ],
      "writes": true
    },
    {
      "op": "stop",
      "description": "结束当前专注，恢复相关免打扰设置",
      "fields": [],
      "writes": true
    }
  ],
  "抽签": [
    {
      "op": "save",
      "description": "创建/修改轮盘；id仅修改时填，name标题，options=[{name,weight}]，权重比例不要求和为1，spinAfter=true表示保存后立即抽签",
      "fields": [
        "id",
        "name",
        "options",
        "spinAfter"
      ],
      "writes": true
    },
    {
      "op": "select",
      "description": "选择已保存轮盘",
      "fields": [
        "id"
      ],
      "writes": false
    },
    {
      "op": "delete",
      "description": "删除已保存轮盘",
      "fields": [
        "id"
      ],
      "writes": true
    },
    {
      "op": "spin",
      "description": "按当前轮盘的真实权重抽签；不得编造结果",
      "fields": [],
      "writes": false
    },
    {
      "op": "configure",
      "description": "pointer布尔=指针转，duration=长/短/自定义，customMs=100..60000",
      "fields": [
        "pointer",
        "duration",
        "customMs"
      ],
      "writes": true
    }
  ],
  "官网通知": [
    {
      "op": "filter",
      "description": "query关键词；sources网站域名数组（空数组=不选来源）；expanded控制来源选择区：false折叠、true展开；summary控制通知正文：false仅标题、true标题加摘要，两者独立，只改用户指定项",
      "fields": [
        "query",
        "sources",
        "expanded",
        "summary"
      ],
      "writes": false
    },
    {
      "op": "select",
      "description": "选择具体通知以便进一步提问",
      "fields": [
        "id"
      ],
      "writes": false
    },
    {
      "op": "refresh",
      "description": "同步官网通知",
      "fields": [],
      "writes": false
    },
    {
      "op": "follow",
      "description": "关注或取消关注通知来源；source为sources列表中的网站域名，enabled布尔；新通知由系统后台定期检查",
      "fields": [
        "source",
        "enabled"
      ],
      "writes": true
    },
    {
      "op": "open",
      "description": "打开指定通知的官方原文链接",
      "fields": [
        "id"
      ],
      "writes": false
    }
  ],
  "实时翻译": [
    {
      "op": "configure",
      "description": "from/to语言名称，asrContext术语背景，translationHint翻译偏好，original布尔，size16..26",
      "fields": [
        "from",
        "to",
        "asrContext",
        "translationHint",
        "original",
        "size"
      ],
      "writes": true
    },
    {
      "op": "translate",
      "description": "把text加入实时翻译记录并生成译文，可能产生DeepSeek用量",
      "fields": [
        "text"
      ],
      "writes": true
    },
    {
      "op": "start",
      "description": "开始实时收听并翻译，需要麦克风权限及两种密钥",
      "fields": [],
      "writes": true
    },
    {
      "op": "stop",
      "description": "停止本页实时收听",
      "fields": [],
      "writes": true
    },
    {
      "op": "clear",
      "description": "清空实时翻译历史，需先停止录音并等待翻译完成",
      "fields": [],
      "writes": true
    }
  ],
  "课堂生词": [
    {
      "op": "configure",
      "description": "已掌握词库level=基础/高中/四级/六级，逐级累计过滤；asrContext为课程术语最多400字，下次开始生效",
      "fields": [
        "level",
        "asrContext"
      ],
      "writes": true
    },
    {
      "op": "start",
      "description": "持续收听课堂，只保留超出已掌握词库的英语生词。使用阿里云语音识别计费，需要麦克风权限",
      "fields": [],
      "writes": true
    },
    {
      "op": "stop",
      "description": "暂停课堂生词收听，保留生词记录",
      "fields": [],
      "writes": true
    },
    {
      "op": "known",
      "description": "把word标为已掌握或恢复，known=true/false；只接受真实词库单词，默认true",
      "fields": [
        "word",
        "known"
      ],
      "writes": true
    },
    {
      "op": "search",
      "description": "搜索已记录生词的英文或中文释义",
      "fields": [
        "query"
      ],
      "writes": false
    },
    {
      "op": "clear",
      "description": "新一课：清空本机本课生词，保留词库设置及个人已掌握词，必须先停止收听",
      "fields": [],
      "writes": true
    }
  ],
  "地图": [
    {
      "op": "heat_view",
      "description": "切换导航/热力图，mode=导航/热力图，range=今天/近7天/近30天/近半年/自定义；start/end日期",
      "fields": [
        "mode",
        "range",
        "start",
        "end"
      ],
      "writes": false
    },
    {
      "op": "heat_record",
      "description": "开启或停止个人位置记录，enabled布尔；开启需精确定位权限",
      "fields": [
        "enabled"
      ],
      "writes": true
    },
    {
      "op": "heat_clear",
      "description": "删除全部个人热力统计，必须先停止记录",
      "fields": [],
      "writes": true
    },
    {
      "op": "route",
      "description": "设置参考路线，from=我的位置表示实时定位，或填真实楼号；to填真实楼号。省略沿用当前值，空字符串仅用于明确清除",
      "fields": [
        "from",
        "to"
      ],
      "writes": false
    },
    {
      "op": "view",
      "description": "orientation=固定/跟随，focus=自己/全校，zoom=0.65..7；地图始终平滑转向",
      "fields": [
        "orientation",
        "focus",
        "zoom"
      ],
      "writes": false
    },
    {
      "op": "route_select",
      "description": "切换已计算出的路线；index从1开始，1为最短参考路线，2为备选；省略则切换下一条，只有一条时不能切换",
      "fields": [
        "index"
      ],
      "writes": false
    }
  ],
  "会议纪要": [
    {
      "op": "configure",
      "description": "设置录音摘要：language识别语言、asrContext识别术语最多400字、summaryHint摘要偏好最多1200字；只影响后续录音和摘要",
      "fields": [
        "language",
        "asrContext",
        "summaryHint"
      ],
      "writes": true
    },
    {
      "op": "create",
      "description": "新建录音记录，title名称，kind=课程/会议/其他",
      "fields": [
        "title",
        "kind"
      ],
      "writes": true
    },
    {
      "op": "view",
      "description": "查看录音记录：folderId；clipId选单条，all=true选全部；不传两者则保持当前范围。query仅在选中范围搜索；tab=转写/摘要",
      "fields": [
        "folderId",
        "clipId",
        "all",
        "query",
        "tab"
      ],
      "writes": false
    },
    {
      "op": "record_start",
      "description": "开始录音并保存到folderId；如需新建同时录音则提供title和kind；可能产生ASR费用",
      "fields": [
        "folderId",
        "title",
        "kind"
      ],
      "writes": true
    },
    {
      "op": "record_stop",
      "description": "结束会议录音，不停止其他功能的语音输入",
      "fields": [],
      "writes": true
    },
    {
      "op": "summarize",
      "description": "生成或更新folderId的摘要，发送转写给DeepSeek并计费",
      "fields": [
        "folderId"
      ],
      "writes": true
    },
    {
      "op": "summary_cancel",
      "description": "取消正在进行的摘要任务",
      "fields": [],
      "writes": true
    },
    {
      "op": "play",
      "description": "回听clipId，atMs为毫秒起点（默认0）",
      "fields": [
        "clipId",
        "atMs"
      ],
      "writes": false
    },
    {
      "op": "pause",
      "description": "暂停当前回听",
      "fields": [],
      "writes": false
    },
    {
      "op": "rename",
      "description": "folderId重命名会议或clipId重命名录音，两者只填一个，name新名称",
      "fields": [
        "folderId",
        "clipId",
        "name"
      ],
      "writes": true
    },
    {
      "op": "reorder",
      "description": "folderId及其全部clipIds数组，按希望顺序排列",
      "fields": [
        "folderId",
        "clipIds"
      ],
      "writes": true
    },
    {
      "op": "transcribe",
      "description": "向阿里云发送clipId音频进行补转写/重转写，旧文字保留一份",
      "fields": [
        "clipId"
      ],
      "writes": true
    },
    {
      "op": "edit_line",
      "description": "修正某句转写：clipId、startMs原时间戳、text新文字",
      "fields": [
        "clipId",
        "startMs",
        "text"
      ],
      "writes": true
    },
    {
      "op": "restore_text",
      "description": "恢复clipId上次转写文本，原音频保持不变",
      "fields": [
        "clipId"
      ],
      "writes": true
    },
    {
      "op": "export",
      "description": "导出会议转写/摘要或单段音频/转写，folderId或clipId，format=audio/transcript/summary；需手动选择保存位置",
      "fields": [
        "folderId",
        "clipId",
        "format"
      ],
      "writes": true
    },
    {
      "op": "delete_folder",
      "description": "永久删除folderId会议及其所有录音、转写、摘要",
      "fields": [
        "folderId"
      ],
      "writes": true
    },
    {
      "op": "delete_clip",
      "description": "永久删除clipId对应音频和文字",
      "fields": [
        "clipId"
      ],
      "writes": true
    }
  ],
  "二手信息": [
    {
      "op": "search",
      "description": "搜索二手信息，query关键词，kind=buy/sell/空，mine是否只看自己",
      "fields": [
        "query",
        "kind",
        "mine"
      ],
      "writes": false
    },
    {
      "op": "detail",
      "description": "打开真实信息id，查看描述与公开联系方式",
      "fields": [
        "id"
      ],
      "writes": false
    },
    {
      "op": "editor",
      "description": "新建发布草稿或编辑自己的id；未登录时打开登录页",
      "fields": [
        "id"
      ],
      "writes": false
    },
    {
      "op": "compose",
      "description": "从任意页面新建二手信息；kind=buy/sell，title，description可空，contacts={QQ/微信/手机:值}；publish默认false，发布需明确授权且consent=true",
      "fields": [
        "kind",
        "title",
        "description",
        "contacts",
        "publish",
        "consent"
      ],
      "writes": true
    },
    {
      "op": "status",
      "description": "修改自己的id，status=sold/withdrawn，已完成/下架",
      "fields": [
        "id",
        "status"
      ],
      "writes": true
    },
    {
      "op": "delete",
      "description": "永久删除自己发布的信息与无引用图片",
      "fields": [
        "id"
      ],
      "writes": true
    },
    {
      "op": "draft",
      "description": "填写当前草稿；kind=buy/sell，title，description可空，contacts={QQ/微信/手机:值}，仅填写用户提供的联系方式",
      "fields": [
        "kind",
        "title",
        "description",
        "contacts"
      ],
      "writes": true
    },
    {
      "op": "choose_image",
      "description": "打开图片选择器，选择后压缩上传；需用户选择图片",
      "fields": [],
      "writes": true
    },
    {
      "op": "publish",
      "description": "发布/保存当前草稿到服务器并公开联系方式，consent=true仅在用户明确同意公开时提供",
      "fields": [
        "consent"
      ],
      "writes": true
    }
  ],
  "资料库": [
    {
      "op": "search",
      "description": "筛选资料库，query为关键词，kind可选全部/图片/PDF/文档/表格/演示/音频/视频/压缩包/其他",
      "fields": [
        "query",
        "kind"
      ],
      "writes": false
    },
    {
      "op": "select",
      "description": "查看文件，图片直接预览，id来自资料库查询",
      "fields": [
        "id"
      ],
      "writes": false
    },
    {
      "op": "import",
      "description": "打开系统文件选择器，用户可选任意类型的文件",
      "fields": [],
      "writes": true
    }
  ]
}
