# Private server environment. Blank values are intentional.
DAPAN_MODE=production
DAPAN_DATA=/opt/dapan/data
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_TOKEN=
# Basic public trial is disabled until explicitly configured.
SHARED_AI_ENABLED=0
DEEPSEEK_API_KEY=
SHARED_SPEECH_ENABLED=0
ALIYUN_API_KEY=
# For the separate notice-crawler environment file:
NOTICE_MODEL=deepseek-flash
NOTICE_AI_DAILY_LIMIT=160
